			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/parking/list",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"parking",
						"list"
					]
				},
				"description": "Lista todas as áreas de estacionamento cadastradas.\n\nRetorna array com:\n- parking_id\n- name\n- description\n- created_at\n- slots_defined\n- total_slots"
			},
			"response": []
		},
		{
			"name": "6. Image - Obter Imagem de Referência",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/parking/image/{{parking_id}}",
					"host": [
						"{{base_url}}"
