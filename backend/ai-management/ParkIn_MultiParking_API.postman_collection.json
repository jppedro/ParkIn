							"value": "{{parking_id}}",
							"description": "UUID da área de estacionamento"
						}
					]
				},
				"description": "Retorna o status atual de uma área, incluindo:\n- Metadados da área\n- Total de vagas\n- Última detecção realizada (se houver)"
			},
			"response": []
		},
		{
